{
  "name": "chess-guess",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:miniprogram": "tsc -p core/tsconfig.mp.json && node pipeline/src/emit.ts && tsc -p miniprogram/tsconfig.json",
    "compile:miniprogram": "tsc -p miniprogram/tsconfig.json",
    "verify:miniprogram": "node pipeline/checks/verify-miniprogram-logic.ts",
    "pipeline:download": "node pipeline/src/download.ts",
    "pipeline:convert": "npx tsx pipeline/src/convert.ts",
    "pipeline:validate": "npx tsx pipeline/src/validate.ts",
    "pipeline:tree": "npx tsx pipeline/src/build-tree.ts",
    "check:notation": "npx tsx pipeline/checks/check-notation.ts",
    "check:rules": "npx tsx pipeline/checks/check-rules.ts",
    "check:tree": "npx tsx pipeline/checks/check-opening-tree.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
